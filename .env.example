# 本文件是配置的**权威清单**：代码里 process.env 引用的每个变量都应在此登记。
# 复制为 .env 后填值；.env 含真实密钥，绝不入库/进镜像（见 .gitignore、.dockerignore）。
# 绝不在本文件写真实密钥——只放占位与说明。

# ===== 应用 =====
APP_BASE_URL=http://localhost:3000
# 会话签名密钥。生产必须设强随机 >=32 字符（openssl rand -hex 32）；
# 非 MOCK 环境缺失/过短会拒绝启动（fail-fast）。
SESSION_SECRET=
# 是否信任反代转发头(x-forwarded-*)推断域名。默认：MOCK=true 时 true、生产 false。
# 生产若在 nginx/CF 后且已清洗这些头，可显式设 true；否则固定用 APP_BASE_URL 防开放重定向。
TRUST_FORWARDED_HEADERS=

# ===== 时区（部署关键）=====
# 结算按服务器本地日折算——容器默认 UTC 会把结算日切错（CI UTC grace 窗 flaky 的生产版）。
# Docker：镜像已装 tzdata 且 docker-compose.yml 已设 TZ=Asia/Shanghai；此项供非 Docker/本地对齐。
TZ=Asia/Shanghai

# ===== 管理后台 =====
# 进 /admin 的两种凭据，任一满足即可。两者都留空则无人能进后台。
# 管理密码：生产务必设强随机值。
ADMIN_PASSWORD=
# 指定 Linux.do 管理员用户 ID（逗号分隔，如 123,456）。留空则仅靠 ADMIN_PASSWORD。
ADMIN_LINUXDO_IDS=

# ===== Linux.do OAuth（后面补，留空也能启动，只是登录点不通）=====
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 最低信任等级门槛（防小号，0=不限制）
MIN_TRUST_LEVEL=0
# 可选：覆盖 Linux.do connect 端点（默认即可）
# LINUXDO_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
# LINUXDO_TOKEN_URL=https://connect.linux.do/oauth2/token
# LINUXDO_USERINFO_URL=https://connect.linux.do/api/user

# ===== CPA 网关（P1 才用到，先留空，MOCK 模式下不需要）=====
# 模拟模式：true=用内置模拟 CPA（默认，无需真实网关）；填好下面两项后设 false 切真实。
# 🔴 公网/对外部署必须 MOCK=false：MOCK=true 会开放免鉴权预览登录 /api/auth/dev-login，且默认信任
#    x-forwarded-* 头（可被伪造域名/开放重定向），仅限本机/内网预览。口径：只有恰为 false 才算非 mock。
MOCK=true
CPA_BASE_URL=
CPA_MANAGEMENT_KEY=
# 可选：MOCK=true 时模拟 CPA 的持久化文件路径（默认 data/mock-cpa.json，落在 data 卷内）。
# 一般无需改；真实模式(MOCK=false)不使用此项。
# MOCK_CPA_PATH=data/mock-cpa.json

# ===== 数据库 / 备份 =====
# SQLite 库路径。默认 data/app.db（容器内 cwd=/app → /app/data/app.db，正落在持久卷）。
# 🔴 容器内若覆盖，务必仍落在 /app/data 卷内，否则容器重启丢库。
# DB_PATH=data/app.db
# 备份输出目录（VACUUM INTO 快照）。默认 data/backups，同在持久卷内。
# BACKUP_DIR=data/backups
# 备份保留份数（只保留最新 N 份，更旧的删）。
BACKUP_KEEP=7

# ===== 后台自动巡检 worker =====
# 开关：true=服务启动后自动巡检 pending 账号（需常驻 Node 服务）
WORKER_ENABLED=true
# 巡检间隔（毫秒）。mock 下 8000 便于演示；真实对接 cpamp 时建议放大到分钟级
WORKER_INTERVAL_MS=8000
